{
  "name": "omarch-deck",
  "version": "0.2.0",
  "private": true,
  "description": "An Omarchy-native controller for the Loupedeck CT",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "diagnose:lights": "node dist/src/diagnose-lights.js",
    "dev": "tsx src/main.ts",
    "start": "node dist/src/main.js",
    "test": "node --import tsx --test test/**/*.test.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "loupedeck": "^7.0.3",
    "yaml": "^2.8.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "allowScripts": {
    "canvas@3.2.3": true,
    "@serialport/bindings-cpp@13.0.0": true,
    "esbuild@0.28.2": true
  }
}
